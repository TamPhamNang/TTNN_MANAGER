<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>@ViewData["Title"] · Language Center</title>
  <link rel="stylesheet" href="~/css/site.css">
  <link rel="stylesheet" href="~/css/form.css">
</head>
<body>
  <a class="skip-link" href="#content">Đến nội dung chính</a>
  <partial name="_Sidebar" />
  <div class="workspace">
    <partial name="_Navbar" />
    @RenderBody()
    <footer>Language Center <span>Prototype · dữ liệu đặt lại khi tải trang</span></footer>
  </div>
  <dialog id="registration" aria-label="Đăng ký lớp">
    <form id="enrollment">
      <div class="section-head"><h2>Đăng ký lớp</h2><button type="button" data-close-dialog aria-label="Đóng">×</button></div>
      <p class="muted">Chọn học viên và lớp đang tuyển còn chỗ.</p>
      <label>Học viên<select name="student" required></select></label>
      <label>Lớp học<select name="classroom" required></select></label>
      <p class="form-error" role="alert"></p>
      <button class="primary" type="submit">Xác nhận đăng ký</button>
    </form>
  </dialog>
  <dialog id="management-dialog" aria-label="Thông tin quản lý"></dialog>
  <dialog id="confirm-dialog" aria-labelledby="confirm-title"></dialog>
  <div id="toast" role="status" aria-live="polite"></div>
  <script src="~/js/site.js"></script>
</body>
</html>
